	partition Calendrier = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(ventes_TRS_2026[Date]),
				        MAX(ventes_TRS_2026[Date])
				    ),
				    "Année", YEAR([Date]),
				    "Mois", FORMAT([Date], "MMMM"),
				    "NumMois", MONTH([Date]),
				    "Trimestre", "T" & FORMAT([Date], "Q")
				)
				
				```

	annotation PBI_Id = 46be081fc8b64e47aa61997f3550b81e

